# Database. Use a libsql:// URL and token for Turso in production.
TURSO_DATABASE_URL=file:local.db
TURSO_AUTH_TOKEN=

# Cloudinary (required for registration photos and admin logo uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Authentication. Generate a unique secret with: openssl rand -base64 32
JWT_SECRET=
ADMIN_DEFAULT_EMAIL=admin@okgs.edu.bd
ADMIN_DEFAULT_PASSWORD=

# SMTP (Nodemailer). SMTP settings take precedence when configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=Omar Kindergarten School <events@example.com>

# Optional fallback email provider (Resend)
RESEND_API_KEY=
RESEND_FROM=Omar Kindergarten School <onboarding@resend.dev>

# Public site URL used for email links
NEXT_PUBLIC_APP_URL=http://localhost:3000
